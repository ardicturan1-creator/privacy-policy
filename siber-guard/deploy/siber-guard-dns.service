[Unit]
Description=Siber-Guard DNS filtreleme proxy
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/siber-guard/src
ExecStart=/usr/bin/python3 /opt/siber-guard/src/dns_proxy.py --listen 0.0.0.0 --port 53 --upstream 1.1.1.1 --risk-threshold 0.6
Restart=on-failure
RestartSec=3
User=root
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
